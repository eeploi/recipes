#!/usr/bin/env bash
# The one release command: shows what is released and what changed since the last release, runs the
# checks, and only after you confirm builds from main's head, signs with the recipes key, verifies,
# publishes the GitHub release from a checked draft and checks what went up. It stops on the first
# failure.
# D-2: signed in the maintainer's own terminal, never unattended.
# Run it yourself, in your own terminal: minisign asks for the key password, which is never
# stored, passed in or logged. Releases are immutable: it asks before anything is built or signed.
# --check runs the checks only: nothing built, signed or published.
# The secret key is ~/.minisign/eeploi-recipes.key, or RECIPES_KEY when set; its public key must
# be next to it (.pub) and the same as minisign.pub.
# It takes no values: the version, the helper and the providers come from main's head
# (bin/release-values.sh, D-26).
# usage: bin/release [--check]
set -euo pipefail
export LC_ALL=C
cd "$(dirname "$0")/.."

REPO=eeploi/recipes
HELPER_REPO=eeploi/helper
# The CI jobs that stand for the tests: each must have passed on the commit released. A job renamed
# in ci.yml must be renamed here too: a job not found stops the release.
CI_JOBS=(check 'server (8.5)' 'server (8.4)')
key=${RECIPES_KEY:-$HOME/.minisign/eeploi-recipes.key}
check_only=
[ "${1:-}" != --check ] || { check_only=1; shift; }
[ "$#" -eq 0 ] || { echo "usage: bin/release [--check]" >&2; exit 64; }
# shellcheck source=bin/release-values.sh
. bin/release-values.sh

line() { printf '%s\n' "=========================================="; }
# field <label> <value>: one line of the overview.
field() { printf '%-18s %s\n' "$1" "$2"; }
heading() { printf '\n%s\n' "$1"; }
ok() { printf '  ✓ %s\n' "$*"; }
# printable: no control character (ESC, CR, tab and the like; a newline stays), also none of UTF-8's C1
# controls (U+0080 to U+009F, such as CSI), so text from GitHub or a commit can't move the cursor or
# rewrite what the screen shows. Other UTF-8 stays.
printable() { tr -d '\000-\011\013-\037\177' | sed $'s/\xc2[\x80-\x9f]//g'; }

# While a draft may be on GitHub, $left says so and how to delete it: every failure then ends with it,
# also one that stops without fail() (Ctrl-C). Once published, it says the version is released.
left=
work=$(mktemp -d)
# $built while dist/VERSION is this run's and not published: a run that stops removes it, so the next
# run finds it free.
built=
on_exit() {
  local status=$?
  [ "$status" -eq 0 ] || [ -z "$left" ] || printf '  stopped: %s\n' "$left" >&2
  [ "$status" -eq 0 ] || [ -z "$built" ] || rm -rf -- "$out"
  rm -rf "$work"
}
trap on_exit EXIT
# A failure can carry gh's own output: printable only.
fail() { printf '  ✗ %s\n' "$(printf '%s' "$*${left:+: $left}" | printable)" >&2; left=; exit 1; }
# Any other command that fails stops here too.
trap 'fail "line $LINENO failed"' ERR
# key_id <base64 public key>: its key id as minisign prints it: bytes 3 to 10, lowest byte first.
key_id() {
  local bytes id='' i
  read -ra bytes < <(base64 -d <<< "$1" 2>/dev/null | od -An -tx1 -j2 -N8)
  for ((i = ${#bytes[@]} - 1; i >= 0; i--)); do id+=${bytes[i]}; done
  tr a-f A-F <<< "$id"
}
# remote_tag: the commit of $tag on GitHub, a plain tag or not, or nothing.
remote_tag() {
  git ls-remote origin "refs/tags/$tag" "refs/tags/$tag^{}" |
    awk -v t="refs/tags/$tag^{}" 'NR == 1 { plain = $1 } $2 == t { peeled = $1 } END { print (peeled != "" ? peeled : plain) }'
}
# gh_has <path>: true when GitHub has it, false when not (404); anything else stops.
gh_has() {
  gh api "$1" --silent 2>"$work/api" && return
  grep -q 'HTTP 404' "$work/api" || fail "GitHub did not answer for $1: $(cat "$work/api")"
  return 1
}
# release_state: sets $release to published, draft or nothing for $tag. The tag lookup doesn't find
# drafts, and a draft has no tag yet: the list does.
release_state() {
  local states
  states=$(gh api "repos/$REPO/releases?per_page=100" --paginate \
    --jq ".[] | select(.tag_name == \"$tag\") | if .draft then \"draft\" else \"published\" end") ||
    fail "GitHub did not list the releases of $REPO"
  case $states in *published*) release=published ;; *draft*) release=draft ;; *) release= ;; esac
}
# assets <files...>: their names, sorted, comma separated, as release_view prints them.
assets() { printf '%s\n' "${@##*/}" | sort | paste -sd , -; }
# release_view <field>: "<isDraft> <field> <asset names, as assets prints them> <title>" of release $tag.
release_view() {
  gh release view "$tag" -R "$REPO" --json "isDraft,$1,assets,name" \
    --jq "\"\\(.isDraft) \\(.$1) \\([.assets[].name] | sort | join(\",\")) \\(.name)\""
}
# newer <a> <b>: version a is higher than b, each part compared as a number.
newer() {
  local IFS=. a b i
  read -r -a a <<< "$1"
  read -r -a b <<< "$2"
  for i in 0 1 2; do
    [ "$((10#${a[i]}))" -eq "$((10#${b[i]}))" ] || { [ "$((10#${a[i]}))" -gt "$((10#${b[i]}))" ]; return; }
  done
  return 1
}
# tag_list local|remote: each v* tag and its commit, sorted. The build reads every v* tag for
# the versions in the manifest, so they must be GitHub's.
tag_list() {
  if [ "$1" = local ]; then
    git for-each-ref --format='%(refname)' 'refs/tags/v*' | while IFS= read -r ref; do
      echo "${ref#refs/tags/} $(git rev-parse "$ref^{commit}")"
    done
  else
    git ls-remote --tags origin 'v*' | awk '{ sub("^refs/tags/", "", $2) }
      $2 ~ /\^\{\}$/ { sub("\\^\\{\\}$", "", $2); peeled[$2] = $1; next } { plain[$2] = $1 }
      END { for (t in plain) print t, (t in peeled ? peeled[t] : plain[t]) }'
  fi | sort
}
# verify <folder>: what bin/build-release.sh --verify checks, on that folder: exactly the files a fresh
# build from the checked commit makes, the same bytes, and a .minisig per manifest that verifies
# against minisign.pub, prehashed only (D-1). Its output only when it fails.
verify() {
  env -u RECIPES_PUB RECIPES_COMMIT="$head" RECIPES_DIR="$1" \
    bin/build-release.sh --verify "$version" "$min_helper" "${providers[@]}" > "$work/verify" 2>&1 ||
    { sed 's/^/    /' "$work/verify" | printable >&2; return 1; }
}
# same <folder>: it holds the files built and signed in $out, byte for byte, the .minisig files too.
# verify then checks them again on their own, against a fresh build and minisign.pub.
same() {
  local f
  for f in "${files[@]}"; do
    cmp -s "$f" "$1/${f##*/}" || { echo "    ${f##*/} differs" >&2; return 1; }
  done
}
sha256() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

for cmd in git gh minisign base64 od paste; do
  command -v "$cmd" >/dev/null || fail "$cmd is not installed"
done

# What the overview shows, read first: nothing changes but the fetch of main.
git fetch -q origin main || fail "could not fetch main from GitHub"
branch=$(git branch --show-current)
head=$(git rev-parse HEAD)
short=$(git rev-parse --short "$head")
# D-26: the version, the helper and the providers, from the commit released, never from arguments.
from_head() { git show "$head:$1" > "$work/$2" 2>/dev/null || fail "no $1 at $short"; }
from_head CHANGELOG.md changelog
version=$(changelog_version "$work/changelog") || fail "CHANGELOG.md: $version"
from_head .github/workflows/ci.yml ci.yml
min_helper=$(helper_tag "$work/ci.yml") || fail ".github/workflows/ci.yml: $min_helper"
helper_pub=$(helper_pubkey "$work/ci.yml") || fail ".github/workflows/ci.yml: $helper_pub"
from_head providers providers
list=$(providers_list "$work/providers") || fail "providers: $list"
providers=()
while IFS= read -r provider; do providers+=("$provider"); done <<< "$list"
tag=v$version
title="eeploi-recipes $version"
out=dist/$version
undo="check it with gh release view $tag -R $REPO, delete it with gh release delete $tag -R $REPO, then run this again"
tag_list local > "$work/tags.local"
tag_list remote > "$work/tags.remote" || fail "could not list the tags on GitHub"
# The previous release: the highest v* tag on GitHub.
previous=$(sed -n 's/^v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) .*/\1/p' "$work/tags.remote" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
pub_id=$(key_id "$(sed -n 2p minisign.pub)")
helper_id=$(key_id "$helper_pub")

line
printf 'EEPLOI RECIPES  ·  release\n'
line
field "Previous version" "${previous:-none}${previous:+   (v$previous)}"
field "New version" "$version"
field "Commit" "$short  ${branch:-no branch}"
field "Key" "$pub_id"
field "Needs helper" "$min_helper   (HELPER_TAG v$min_helper)"
field "Providers" "${providers[*]}"
line

heading "Checks"
[ "$branch" = main ] || fail "not on main"
[ -z "$(git status --porcelain)" ] || fail "uncommitted changes"
[ "$head" = "$(git rev-parse origin/main)" ] || fail "main is not the same as GitHub's main: pull or push first"
ok "main is clean and matches GitHub"
diff "$work/tags.local" "$work/tags.remote" | sed -n 's/^</    here only or other:/p; s/^>/    GitHub only or other:/p' | printable >&2 || true
cmp -s "$work/tags.local" "$work/tags.remote" || fail "the v* tags here are not GitHub's (above): git fetch --tags, or remove a local one"
ok "the v* tags here match GitHub's"

# D-21: a v* tag can't move and a release can't change, so a version is released once. Publishing
# makes the tag: until then there is none. The tags here are GitHub's (above).
tagged=$(git rev-parse -q --verify "refs/tags/$tag^{commit}" || true)
[ -z "$tagged" ] || fail "$tag already exists: releases are immutable, release a new version"
release_state
# A draft has no tag and can still go: what a run that stopped before publishing leaves.
[ "$release" != draft ] || fail "$REPO has a draft release $tag, left by a run that stopped: $undo"
[ "$release" != published ] || fail "$REPO already has a release $tag: releases are immutable, release a new version"
# Releases only go up: no fix for an older line, which servers refuse anyway.
if [ -n "$previous" ]; then
  ! newer "$previous" "$version" || fail "$version is lower than $previous: releases only go up"
  newer "$version" "$previous" || fail "$version is not higher than $previous: releases only go up"
fi
ok "$version is higher than every released version"

# changelog_version (above) read ## Unreleased, empty, then ## VERSION with lines under it.
ok "CHANGELOG: ## $version, Unreleased empty"

# The helper every server of this release needs: released (a draft has no tag and isn't found), signed
# with the helper key CI pins (HELPER_PUBKEY, prehashed only), and the version it says it is.
gh_has "repos/$HELPER_REPO/releases/tags/v$min_helper" || fail "no eeploi-helper release v$min_helper"
mkdir "$work/helper"
gh release download "v$min_helper" -R "$HELPER_REPO" -p eeploi-helper -p eeploi-helper.minisig -D "$work/helper" 2>"$work/api" ||
  fail "could not download eeploi-helper v$min_helper: $(cat "$work/api")"
minisign -V -H -q -P "$helper_pub" -m "$work/helper/eeploi-helper" >/dev/null 2>&1 ||
  fail "eeploi-helper v$min_helper does not verify against HELPER_PUBKEY ($helper_id)"
grep -qxF "VERSION='$min_helper'" "$work/helper/eeploi-helper" || fail "eeploi-helper v$min_helper is not VERSION='$min_helper'"
ok "helper v$min_helper is released, and its key matches HELPER_PUBKEY ($helper_id)"

# CI's own run on this exact commit stands for the tests and shellcheck: the latest run of ci.yml for
# the push to main, passed as a whole, and each job in CI_JOBS there once, finished and passed.
run=$(gh run list -R "$REPO" --commit "$head" --workflow ci.yml --event push --branch main --limit 1 \
  --json databaseId --jq '.[0].databaseId // ""') || fail "could not ask GitHub for CI on $short"
[ -n "$run" ] || fail "CI has no run on main at $short yet"
[[ $run =~ ^[0-9]+$ ]] || fail "could not read CI's run on $short ($run)"
gh run view "$run" -R "$REPO" --json headSha,event,headBranch,status,conclusion,jobs \
  --jq '"\(.headSha) \(.event) \(.headBranch)", "\(.status)/\(.conclusion)", (.jobs[] | "\(.name)\t\(.status)/\(.conclusion)")' \
  > "$work/ci" || fail "could not read CI's run $run on $short"
{ read -r ci_sha ci_event ci_branch; read -r ci_state; } < "$work/ci" || true
[ "$ci_sha" = "$head" ] || fail "CI's run $run is not on $short ($ci_sha)"
[ "$ci_event $ci_branch" = "push main" ] || fail "CI's run $run is not for the push to main ($ci_event $ci_branch)"
[ "$ci_state" = completed/success ] || fail "CI's run $run on $short has not passed ($ci_state)"
passed=
for job in "${CI_JOBS[@]}"; do
  got=$(awk -F '\t' -v j="$job" 'NR > 2 && $1 == j { print $2 }' "$work/ci" | paste -sd , -)
  [ -n "$got" ] || fail "CI's run $run on $short has no job named $job"
  [ "$got" = completed/success ] || fail "CI's $job job on $short has not passed ($got)"
  passed+="${passed:+, }\`$job\`"
done
ok "CI $passed passed on $short"

git ls-tree --name-only "$head" | grep -q '^ubuntu-' || fail "main has no ubuntu-* folder"
# The secret key's id can't be read without its password; its public key next to it must be
# minisign.pub, and the signatures are checked against minisign.pub.
case "$key" in /*) ;; *) fail "RECIPES_KEY must be an absolute path: $key" ;; esac
[ -f "$key" ] || fail "no secret key at $key (set RECIPES_KEY to use another)"
key_pub=${key%.key}.pub
[ -f "$key_pub" ] || fail "no public key at $key_pub next to the secret key"
[ "$(sed -n 2p "$key_pub")" = "$(sed -n 2p minisign.pub)" ] ||
  fail "$key_pub ($(key_id "$(sed -n 2p "$key_pub")")) is not minisign.pub ($pub_id)"
ok "key ${key/#$HOME/~}, the same as minisign.pub"
immutable_on=$(gh api "repos/$REPO/immutable-releases" --jq .enabled) || fail "GitHub did not say whether $REPO has immutable releases"
[ "$immutable_on" = true ] || fail "$REPO does not have immutable releases on"
[ ! -e "$out" ] || fail "$out exists from an earlier run: remove it first (rm -r $out)"
ok "immutable releases on, $out is free"

# What is released: the commits since the previous release, and how many files that go into a release
# changed: what a server runs, the markers and the providers.
# Subjects only while they fit on a screen, never a diff.
if [ -n "$previous" ]; then
  since=refs/tags/v$previous
  ancestor=0
  git merge-base --is-ancestor "$since" "$head" || ancestor=$?
  [ "$ancestor" != 1 ] || fail "v$previous is not in the history of $short"
  [ "$ancestor" = 0 ] || fail "git could not compare v$previous with $short"
  count=$(git rev-list --count "$since..$head")
  changed=$(git diff --name-only "$since" "$head" -- stack first-boot 'ubuntu-*' markers providers) ||
    fail "could not compare v$previous with $short"
  changed=$(grep -c . <<< "$changed" || true)
  commits="$count commits"
  [ "$count" != 1 ] || commits="1 commit"
  server="$changed server files"
  [ "$changed" != 1 ] || server="1 server file"
  ok "Changes since v$previous: $commits, $server changed"
  if [ "$count" -le 10 ]; then
    # "subject (#80)" reads as "#80 subject".
    git log --reverse --format=%s "$since..$head" | printable | sed -E 's/^(.*) \(#([0-9]+)\)$/#\2 \1/; s/^/      /'
  else
    printf '      see them with: git log --oneline v%s..%s\n' "$previous" "$short"
  fi
else
  ok "First release: no earlier version"
fi

if [ -n "$check_only" ]; then
  printf '\nEvery check passed. Nothing built, signed or published (--check).\n'
  exit 0
fi

[ -t 0 ] || fail "run this in your own terminal: minisign asks for the key password"
printf '\n'
# read -p asks on stderr. An end of input is a no.
read -r -p "Sign $version? [y/N] " answer || answer=
[ "$answer" = y ] || fail "stopped: nothing built, signed or published"

built=1
RECIPES_COMMIT=$head bin/build-release.sh "$version" "$min_helper" "${providers[@]}" > "$work/build" 2>&1 ||
  { sed 's/^/    /' "$work/build" | printable >&2; fail "the build failed: nothing signed or published"; }
ok "built from $short, the same bytes as from a tag on it"
for f in "$out"/*; do printf '      %s\n' "${f##*/}"; done

manifests=("$out"/*.manifest)
for m in "${manifests[@]}"; do
  # Prehashed (ED), never -l: -H asks for it, also where it is not the default.
  minisign -S -H -s "$key" -m "$m" || fail "minisign did not sign ${m##*/}: nothing published"
done
verify "$out" || fail "the release does not verify against minisign.pub: nothing published"
for m in "${manifests[@]}"; do ok "signed and verified: ${m##*/}"; done

# The folder or GitHub can change while the question and the password wait: check them again before
# anything goes up.
[ "$(git rev-parse HEAD)" = "$head" ] || fail "the folder moved off $short since the checks: nothing published, run it again"
git fetch -q origin main || fail "could not fetch main from GitHub"
[ "$(git rev-parse origin/main)" = "$head" ] || fail "GitHub's main moved off $short since the checks: nothing published, run it again"
tag_list remote > "$work/tags.now" || fail "could not list the tags on GitHub"
cmp -s "$work/tags.local" "$work/tags.now" || fail "the v* tags on GitHub changed since the checks: nothing published, run it again"
remote=$(remote_tag) || fail "could not ask GitHub for $tag"
[ -z "$remote" ] || fail "$tag was made on GitHub since the checks: release a new version"
release_state
[ -z "$release" ] || fail "a release $tag appeared since the checks"
# D-21: nothing that can't change goes up before its files are checked. The release starts as a
# draft, with no tag; publishing it makes the tag on the checked commit. Until then a failure leaves
# only a draft, which can be deleted, and the version stays free.
files=("$out"/*)
want=$(assets "${files[@]}")
left="nothing was published and $tag was not made. A draft release $tag may be left on GitHub: $undo"
gh release create "$tag" "${files[@]}" -R "$REPO" --draft --target "$head" --title "$title" \
  --notes "Signed with the recipes key $pub_id. Needs eeploi-helper $min_helper." > /dev/null || fail "could not create the draft"
draft=$(release_view targetCommitish) || fail "could not read the draft"
[ "$draft" = "true $head $want $title" ] ||
  fail "the draft is not a draft on $short titled $title with only the files built and signed ($draft)"
mkdir "$work/draft"
gh release download "$tag" -R "$REPO" -D "$work/draft" || fail "could not download the draft's files"
same "$work/draft" || fail "the draft's files are not the ones built and signed"
verify "$work/draft" || fail "the draft does not verify"
ok "draft created, files match"

# A tag made on GitHub since the checks would carry the release: stop while it is a draft.
remote=$(remote_tag) || fail "could not ask GitHub for $tag"
if [ -n "$remote" ]; then
  left=
  fail "$tag was made on GitHub since the checks, so this version can't be released: the draft was not published;" \
    "delete it with gh release delete $tag -R $REPO and release a new version"
fi
if ! gh release edit "$tag" -R "$REPO" --draft=false > /dev/null; then
  # The error can come after GitHub published it: only a release that is still a draft is unpublished.
  state=$(gh release view "$tag" -R "$REPO" --json isDraft --jq .isDraft 2>"$work/view") || state=$(cat "$work/view")
  [ "$state" != true ] || fail "could not publish the draft"
  left=
  [ "$state" != false ] || fail "publishing $tag gave an error, but GitHub shows it published: check gh release view $tag -R $REPO before anything else"
  fail "publishing $tag gave an error, and GitHub could not say whether it is published ($state): check gh release view $tag -R $REPO." \
    "Still a draft: $undo. Published: the version is released"
fi
built=
left="$tag is published, the version is released: check it with gh release view $tag -R $REPO"
got=$(release_view isImmutable) || fail "could not read $tag back from GitHub"
[ "$got" = "false true $want $title" ] ||
  fail "$tag is not an immutable release titled $title with only the files built and signed ($got): check it and the repository's settings"
# A draft's files could still change until it was published: check the published ones too.
mkdir "$work/down"
gh release download "$tag" -R "$REPO" -D "$work/down" || fail "could not download $tag again"
same "$work/down" || fail "the published files are not the ones built and signed"
verify "$work/down" || fail "the published release does not verify"
git fetch -q origin "refs/tags/$tag:refs/tags/$tag" || fail "could not fetch $tag from GitHub"
[ "$(git rev-parse "refs/tags/$tag^{commit}")" = "$head" ] || fail "$tag on GitHub is not $short"
left=
ok "published: $tag, immutable"

printf '\n'
line
printf 'RELEASED  %s\n' "$title"
field "Tag" "$tag  on $short"
field "Key" "$pub_id"
# One line per file, the SHA-256 after the longest name.
width=0
for f in "${files[@]}"; do [ "${#f}" -le "$width" ] || width=${#f}; done
label=SHA-256
for f in "${files[@]}"; do
  field "$label" "$(printf '%-*s  %s' "$((width - ${#out} - 1))" "${f##*/}" "$(sha256 "$f")")"
  label=
done
line
